{
  "name": "run-walk-ride",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-health-connect": "^0.1.1",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.17",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-screen-orientation": "~58.0.3",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.19",
    "expo-sms": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.0",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-maps": "^1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-view-shot": "^6.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "sql.js": "^1.15.0",
    "test-renderer": "^1.3.1",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "gen:gpx": "node scripts/generateSampleGpx.js",
    "gen:plans": "node scripts/generateTrainingPlans.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.ts",
      "src/features/**/*.ts",
      "src/db/**/*.ts",
      "!src/**/*.d.ts",
      "!src/utils/id.ts",
      "!src/db/database.ts",
      "!src/features/tracking/{trackingService,locationSource,simulator,pedometer,permissions,voiceCoach}.ts",
      "!src/features/sensors/bleSensors.ts",
      "!src/features/health/healthSync.ts",
      "!src/features/backup/backupIO.ts",
      "!src/features/share/shareImage.ts",
      "!src/features/workouts/planReminders.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    },
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "\\.gpx$": "<rootDir>/__tests__/helpers/assetStub.js"
    }
  }
}
